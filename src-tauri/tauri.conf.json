{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moviesx",
  "version": "0.2.1",
  "identifier": "com.moviesx.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Moviesx",
        "width": 1280,
        "height": 800,
        "minWidth": 375,
        "minHeight": 640,
        "maximized": true,
        "backgroundColor": "#0f0f0f",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
